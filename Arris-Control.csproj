<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Arris-Control</AssemblyName>
    <Version>0.4.0</Version>
    <Description>Local Windows management for ARRIS SURFboard mAX</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <EnableSingleFileAnalyzer>false</EnableSingleFileAnalyzer>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <RestoreIgnoreFailedSources>true</RestoreIgnoreFailedSources>
    <NuGetAudit>false</NuGetAudit>
    <DebugType>none</DebugType>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
  <ItemGroup><Compile Remove="Android/**/*.cs;Tests/**/*.cs" /></ItemGroup>
  <ItemGroup><EmbeddedResource Include="srp-test-vector.json" /></ItemGroup>
</Project>
