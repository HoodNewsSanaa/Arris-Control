<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>26</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <RootNamespace>ArrisControl</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationId>com.hoodnewssanaa.arriscontrol</ApplicationId>
    <ApplicationTitle>Arris Control</ApplicationTitle>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>0.3.4</ApplicationDisplayVersion>
    <AndroidPackageFormats>apk</AndroidPackageFormats>
    <RuntimeIdentifiers>android-arm64;android-x64</RuntimeIdentifiers>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    <RunAOTCompilation>false</RunAOTCompilation>
    <PublishTrimmed>false</PublishTrimmed>
    <AndroidLinkMode>None</AndroidLinkMode>
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Core.cs;../FirmwareLookupCapture.cs;../FirmwareLookupCaptureSelfTests.cs;../WebUiExperiment.cs;../WebUiExperimentSelfTests.cs;../OfflineSetup.cs;../OfflineSetupSelfTests.cs;../Settings.cs;../RouterDiscovery.cs;../CloudAcquisition.cs;../CloudProtocol.cs;../CognitoCrypto.cs;../AcquisitionStore.cs;../SelfTests.cs;../CloudSelfTests.cs;../DiscoverySelfTests.cs" Link="Shared/%(Filename)%(Extension)" />
    <EmbeddedResource Include="../srp-test-vector.json" />
    <!-- Personal builds only: bundle a private SURFboard reference if present. Never committed (gitignored); CI fails if it exists. -->
    <EmbeddedResource Include="protocol.local.json" Condition="Exists('$(MSBuildProjectDirectory)/protocol.local.json')" LogicalName="ArrisControl.protocol.local.json" />
  </ItemGroup>
</Project>
